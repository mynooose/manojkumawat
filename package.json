    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
