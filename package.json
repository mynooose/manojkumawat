{
  "name": "manojkumawat",
  "version": "1.0.0",
  "private": true,
  "description": "Solution-architect portfolio for manojkumawat.com",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
